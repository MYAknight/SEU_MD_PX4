#!/bin/sh
#
# @name huaqiccc Morphing Quadrotor (Real Hardware)
#
# @class Copter
#
# @type Quadrotor with morphing arms
#
# @maintainer hjq
#
# @output MAIN1: Motor4 front-left  (CW)  → CA_ROTOR3
# @output MAIN2: Motor3 back-left   (CCW) → CA_ROTOR2
# @output MAIN3: Motor2 front-right (CCW) → CA_ROTOR1
# @output MAIN4: Motor1 back-right  (CW)  → CA_ROTOR0
#
# @board px4_fmu-v2 exclude
# @board bitcraze_crazyflie exclude
#

. ${R}etc/init.d/rc.mc_defaults

# =============================================================================
# Motor Geometry: huaqiccc model at theta=0 (arms closed) - UPDATED from real hardware measurements
# PX4 FRD coords: PX+=Front, PY+=Right, PZ+=Down (PZ=0 means motor at FC height)
# =============================================================================
param set-default CA_ROTOR_COUNT 4

# Motor 0: back-right (CW)  [MAIN4]
param set-default CA_ROTOR0_PX -0.1550
param set-default CA_ROTOR0_PY  0.2150
param set-default CA_ROTOR0_PZ 0.0
param set-default CA_ROTOR0_AX  0.0
param set-default CA_ROTOR0_AY  0.0
param set-default CA_ROTOR0_AZ -1.0
param set-default CA_ROTOR0_KM -0.06

# Motor 1: front-right (CCW) [MAIN3]
param set-default CA_ROTOR1_PX  0.2050
param set-default CA_ROTOR1_PY  0.1650
param set-default CA_ROTOR1_PZ 0.0
param set-default CA_ROTOR1_AX  0.0
param set-default CA_ROTOR1_AY  0.0
param set-default CA_ROTOR1_AZ -1.0
param set-default CA_ROTOR1_KM  0.06

# Motor 2: back-left (CCW)   [MAIN2]
param set-default CA_ROTOR2_PX -0.1550
param set-default CA_ROTOR2_PY -0.2150
param set-default CA_ROTOR2_PZ 0.0
param set-default CA_ROTOR2_AX  0.0
param set-default CA_ROTOR2_AY  0.0
param set-default CA_ROTOR2_AZ -1.0
param set-default CA_ROTOR2_KM  0.06

# Motor 3: front-left (CW)   [MAIN1]
param set-default CA_ROTOR3_PX  0.2050
param set-default CA_ROTOR3_PY -0.1650
param set-default CA_ROTOR3_PZ 0.0
param set-default CA_ROTOR3_AX  0.0
param set-default CA_ROTOR3_AY  0.0
param set-default CA_ROTOR3_AZ -1.0
param set-default CA_ROTOR3_KM -0.06

# =============================================================================
# PWM Output Mapping (Pixhawk MAIN channels)
# Reversed mapping verified on real hardware 2026-06-03
# =============================================================================
param set-default PWM_MAIN_FUNC1 104
param set-default PWM_MAIN_FUNC2 103
param set-default PWM_MAIN_FUNC3 102
param set-default PWM_MAIN_FUNC4 101
# PWM limits calibrated from real hardware ESC range (1100-1900us)
param set-default PWM_MAIN_MIN1 1100
param set-default PWM_MAIN_MIN2 1100
param set-default PWM_MAIN_MIN3 1100
param set-default PWM_MAIN_MIN4 1100
param set-default PWM_MAIN_MAX1 1900
param set-default PWM_MAIN_MAX2 1900
param set-default PWM_MAIN_MAX3 1900
param set-default PWM_MAIN_MAX4 1900

# =============================================================================
# Control allocation settings
# =============================================================================
param set-default CA_METHOD 2

# =============================================================================
# Battery Monitoring (3S equivalent for 14.4V regulated DC supply)
# Using 14.4V bench power supply; configured as 3S with 4.8V/cell max.
# V_DIV/A_PER_V kept for Pixhawk 4 Power Module; recalibrate if voltage readout
# does not match the bench supply.
# =============================================================================
param set-default BAT1_N_CELLS 3
param set-default BAT1_V_CHARGED 4.8
param set-default BAT1_V_EMPTY 4.0
param set-default BAT1_V_DIV 18.1
param set-default BAT1_A_PER_V 36.3675
param set-default BAT1_SOURCE 0
param set-default BAT1_CAPACITY -1

# =============================================================================
# EKF2: Indoor MoCap / Vision Positioning (NO GPS)
# =============================================================================
# Height reference: External Vision (MoCap)
# NOTE: EKF2_HGT_REF=GNSS(1) auto-enables GPS, must use Vision(3)
param set-default EKF2_HGT_REF 3

# Disable GPS fusion (indoor no signal)
param set-default EKF2_GPS_CTRL 0

# External Vision (MoCap) fusion: position + height + velocity + yaw
param set-default EKF2_EV_CTRL 15

# MoCap system delay compensation (tested with NOKOV + HM30链路)
param set-default EKF2_EV_DELAY 60

# Disable magnetometer (indoor magnetic interference)
# EKF uses gyro integration + MoCap yaw only
param set-default EKF2_MAG_TYPE 5

# Keep barometer for height backup
param set-default EKF2_BARO_CTRL 1

# =============================================================================
# GPS Configuration (DISABLED for indoor test)
# =============================================================================
# param set-default GPS_1_CONFIG 201

# =============================================================================
# Telemetry / MAVLink (TELEM1 for ground station)
# =============================================================================
param set-default MAV_0_CONFIG 101
param set-default MAV_0_MODE 0
param set-default SER_TEL1_BAUD 115200

# =============================================================================
# RC Configuration: physical RC transmitter (American mode)
# =============================================================================
param set-default COM_RC_IN_MODE 3
param set-default RC_MAP_MODE_SW 5
param set-default RC_MAP_ARM_SW 6

# =============================================================================
# Safety: disable IO safety switch (required for real flight hardware setup)
# This airframe does not use a physical safety switch; keep disabled.
# =============================================================================
param set-default CBRK_IO_SAFETY 22027

# =============================================================================
# Arm checks: relaxed for indoor bench / MoCap test
# =============================================================================
param set-default COM_ARM_WO_GPS 1
param set-default COM_ARM_SDCARD 0
param set-default COM_ARM_EKF_POS 10.0
param set-default COM_ARM_EKF_VEL 10.0
param set-default COM_ARM_EKF_HGT 10.0
param set-default COM_ARM_EKF_YAW 10.0

# =============================================================================
# Landing Detector: use PX4 defaults for normal landing
# Perching-related contact detection and forced disarm are handled by
# the external_force_estimator + flight_executor, not by relaxing these params.
# =============================================================================

# =============================================================================
# Failsafe: indoor safe modes (NO RTL without GPS)
# =============================================================================
# RC loss = Hold (not RTL)
param set-default NAV_RCL_ACT 1

# Data link loss = no action (ground station may reconnect)
param set-default NAV_DLL_ACT 0

# Disable geofence action
param set-default GF_ACTION 0

# In Offboard mode, ignore RC loss (critical for auto-perching)
param set-default COM_RCL_EXCEPT 4

# =============================================================================
# SD Logging: record from boot to capture pre-arm data
# =============================================================================
param set-default SDLOG_MODE 1
param set-default SDLOG_PROFILE 33

# =============================================================================
# Multicopter attitude control tuning (conservative for first flight)
# =============================================================================
param set-default MC_ROLLRATE_P 0.18
param set-default MC_ROLLRATE_I 0.20
param set-default MC_ROLLRATE_D 0.003
param set-default MC_ROLL_P 7.0

param set-default MC_PITCHRATE_P 0.15
param set-default MC_PITCHRATE_I 0.18
param set-default MC_PITCHRATE_D 0.003
param set-default MC_PITCH_P 6.0

param set-default MC_YAWRATE_P 0.25
param set-default MC_YAWRATE_I 0.30
param set-default MC_YAWRATE_D 0.0
param set-default MC_YAW_P 3.5

# =============================================================================
# Hover thrust estimation
# =============================================================================
param set-default MPC_THR_HOVER 0.45

# =============================================================================
# Position control (conservative for real hardware first flight)
# NOTE: SITL tuned values are aggressive. Start conservative and increase.
# =============================================================================
param set-default MPC_XY_P 1.5
param set-default MPC_XY_VEL_P_ACC 2.2
param set-default MPC_XY_VEL_I_ACC 0.4
param set-default MPC_XY_VEL_D_ACC 0.2
param set-default MPC_XY_TRAJ_P 0.7

param set-default MPC_Z_P 1.0
param set-default MPC_Z_VEL_P_ACC 4.0

# =============================================================================
# huaqiccc custom parameters (huaqiccc modifications)
# =============================================================================
param set-default MPCA_MODE 0  # First-flight conservative (was 2); switch to 2(LQR) or 3(MPC) after validation
param set-default MPCA_MPC_ALPHA 20.0
param set-default MPCA_MPC_R_DELTA 0.005
param set-default MPCA_FF_EN 1
param set-default MPCA_FF_BLEND 0.3
param set-default MPCA_FF_MASS 1.15

# EFO_ENABLE (IMU-ICD) is deprecated on the real vehicle. The module is no
# longer started by default, but disable it explicitly just in case.
param set-default EFO_ENABLE 0

# Perching/contact-detection subsystem.
# 0=OFF, 1=DETECT (log only, no FSM), 2=FULL (detect + perching FSM).
# Default to DETECT for safe validation; switch to 2 only after confirming
# contact detection timing against ground truth.
param set-default MPCA_PC_EN 1
param set-default MPCA_PC_TRIG 0

# New position/attitude based contact detector thresholds.
# These were derived from manual perching logs on 2026-06-13.
param set-default MPCA_PC_SERR 0.05
param set-default MPCA_PC_SVEL 0.10
param set-default MPCA_PC_PIT_THR -5.0
param set-default MPCA_PC_DUR_THR 0.30

# Legacy stall-detection parameters (MPCA_PC_GATE, MPCA_PC_STALL_D,
# MPCA_PC_STALL_T) are deprecated and no longer used.

# =============================================================================
# Airframe type: Generic Quadcopter
# =============================================================================
set MAV_TYPE 2

# =============================================================================
# Morphing arm control (AS5600 on I2C, actuator on AUX1)
# Calibrated 2026-06-13: closed=518, expanded=780 (mechanical stop ~775)
# =============================================================================
# AUX1: morphing linear servo (Servo1 function)
# PWM_AUX_REV bit0=1 inverts AUX1 so v=+1.0 -> extend (MIN=1050us)
param set-default PWM_AUX_FUNC1 201
param set-default PWM_AUX_MIN1 1000
param set-default PWM_AUX_MAX1 2000
param set-default PWM_AUX_DIS1 1500
param set-default PWM_AUX_REV 1

# Enable morph control module
param set-default MORPH_EN 1
param set-default MORPH_EMIN 475
param set-default MORPH_EMAX 780
param set-default MORPH_RATE 50

# =============================================================================
# Start control allocator
# =============================================================================
control_allocator start

# =============================================================================
# Start morphing arm controller
# =============================================================================
huaqiccc_morph_control start -b 2
